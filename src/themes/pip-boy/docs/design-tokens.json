{
  "color": {
    "ink": "#f8f5f2",
    "inkMuted": "#e2e8f0",
    "accent": "#fca311",
    "accentStrong": "#ffb84d",
    "surface": "rgba(12, 18, 35, 0.7)",
    "surfaceStrong": "rgba(12, 18, 35, 0.9)",
    "border": "rgba(248, 245, 242, 0.12)",
    "borderStrong": "rgba(248, 245, 242, 0.3)",
    "shadow": "0 22px 50px rgba(2, 6, 23, 0.5)",
    "pageBackground": "radial-gradient(circle at top left, #12213d, #0b1020 50%)"
  },
  "typography": {
    "fontDisplay": "\"Press Start 2P\", monospace",
    "fontBody": "\"Space Grotesk\", sans-serif",
    "label": {
      "fontSize": "10-12px",
      "letterSpacing": "0.08-0.12em",
      "textTransform": "uppercase"
    },
    "body": {
      "fontSize": "11-16px",
      "letterSpacing": "normal"
    }
  },
  "spacing": {
    "framePadding": "10-12px",
    "panelPadding": "8-12px",
    "cardPadding": "16-24px",
    "sectionGap": "12-24px",
    "gridGap": "10-18px"
  },
  "radius": {
    "frame": "24px",
    "panel": "16-20px"
  },
  "border": {
    "frame": "1px solid var(--accent)",
    "panel": "1px solid rgba(248, 245, 242, 0.16-0.2)",
    "divider": "1px solid rgba(252, 163, 17, 0.3)"
  },
  "motion": {
    "entry": ["fadeIn", "floatUp"],
    "highlight": "pulse"
  }
}
